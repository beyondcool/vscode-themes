				"constant.numeric",
				"constant.language",
				"support.constant",
				"constant.character",
				"constant.escape",
				"variable.parameter",
				"keyword.other.unit",
				"keyword.other"
			],
			"settings": {
				"fontStyle": " ",
				"foreground": "#c6c6c6" //F78C6C cb8d12 dcdcdc
			}
		},
		{
			"name": "String, Symbols, Inherited Class, Markup Heading",
