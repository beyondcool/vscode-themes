{
  "name": "zhouhe-dark",
  "publisher": "zhouhe",
  "displayName": "zhouhe-dark",
  "description": "zhouhe vscode theme dark",
  "version": "1.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/beyondcool/vscode-themes.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Themes"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "package": "vsce package",
    "package:install": "bash pkg_and_install.sh"
  },
  "contributes": {
    "commands": [
      {
        "command": "zhouhe-dark.apply",
        "title": "应用主题与推荐设置",
        "category": "zhouhe-dark"
      },
      {
        "command": "zhouhe-dark.toggleWordHighlight",
        "title": "开关「单词高亮接管」",
        "category": "zhouhe-dark"
      },
      {
        "command": "zhouhe-dark.restoreHighlight",
        "title": "恢复 VS Code 内置高亮",
        "category": "zhouhe-dark"
      }
    ],
    "configuration": {
      "title": "zhouhe-dark",
      "properties": {
        "zhouhe-dark.autoApplyOnThemeChange": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "当颜色主题被切换为 `zhouhe-dark` 时，自动应用推荐设置（关闭 minimap、开启语义高亮、关闭 Modern UI 等），并启用单词高亮接管。"
        },
        "zhouhe-dark.wordHighlight.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "由本扩展接管「高亮选中单词 / 出现处」的逻辑。开启后会自动关闭 VS Code 内置的 `editor.selectionHighlight` 与 `editor.occurrencesHighlight`，改由本扩展绘制。仅在 `zhouhe-dark` 主题下生效。"
        },
        "zhouhe-dark.wordHighlight.highlightOnCursor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "只有光标、没有选区时，是否也高亮光标所在单词的出现处。默认 `false` —— 把光标放在 `order` 中间不会触发高亮，必须先选中它。"
        },
        "zhouhe-dark.wordHighlight.mode": {
          "type": "string",
          "enum": [
            "currentFile",
            "openFiles"
          ],
          "enumDescriptions": [
            "只在当前文件里高亮",
            "当前文件 + 所有已打开的可见编辑器"
          ],
          "default": "currentFile",
          "markdownDescription": "匹配范围。"
        },
        "zhouhe-dark.wordHighlight.matchCase": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "匹配时区分大小写。开启后选中 `order` 就**不会**高亮 `Order` / `ORDER`。"
        },
        "zhouhe-dark.wordHighlight.wholeWord": {
          "type": "string",
          "enum": [
            "always",
            "auto",
            "never"
          ],
          "enumDescriptions": [
            "全词匹配：选中 order 绝不会命中 orderBook",
            "同 always（选区已要求是完整单词）",
            "关闭全词边界：选中 order 会命中 orderBook 里的 order"
          ],
          "default": "always",
          "markdownDescription": "是否按「全词」匹配。全词匹配意味着选中 `order` 时只有独立的 `order` 会被高亮，`orderBook`、`order_book`、`order2` 都不会。\n\n注：非词字符（`-`、`.`、`(`、空格等）仍视作边界，所以 `order-book` 里的 `order` 会被高亮。"
        },
        "zhouhe-dark.wordHighlight.minWordLength": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "光标模式下，短于该长度的单词不高亮。"
        },
        "zhouhe-dark.wordHighlight.maxResults": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "单个文件最多高亮的出现处数量。"
        },
        "zhouhe-dark.wordHighlight.maxDocumentLines": {
          "type": "number",
          "default": 200000,
          "minimum": 1,
          "description": "行数超过该值的文件不做高亮，避免卡顿。"
        },
        "zhouhe-dark.wordHighlight.wordSeparators": {
          "type": "string",
          "default": "",
          "markdownDescription": "自定义单词分隔符（直接写字符集合内容，不用带方括号）。留空则使用 VS Code 默认规则。"
        },
        "zhouhe-dark.wordHighlight.currentStyle": {
          "type": "string",
          "enum": [
            "selection",
            "word",
            "strong",
            "find"
          ],
          "enumDescriptions": [
            "editor.selectionHighlightBackground",
            "editor.wordHighlightBackground",
            "editor.wordHighlightStrongBackground",
            "editor.findMatchHighlightBackground"
          ],
          "default": "selection",
          "markdownDescription": "当前选中 / 光标所在那一处的配色，对应主题里的色键。"
        },
        "zhouhe-dark.wordHighlight.matchStyle": {
          "type": "string",
          "enum": [
            "selection",
            "word",
            "strong",
            "find"
          ],
          "enumDescriptions": [
            "editor.selectionHighlightBackground",
            "editor.wordHighlightBackground",
            "editor.wordHighlightStrongBackground",
            "editor.findMatchHighlightBackground"
          ],
          "default": "word",
          "markdownDescription": "其余出现处的配色，取值同 `currentStyle`。"
        }
      }
    },
    "themes": [
      {
        "label": "zhouhe-dark",
        "uiTheme": "vs-dark",
        "path": "./themes/zhouhe-dark.-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.minimap.enabled": false,
      "editor.mouseWheelZoom": true,
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.semanticHighlighting.enabled": true,
      "workbench.experimental.modernUI": false
    },
    "walkthroughs": [
      {
        "id": "zhouhe-dark.getStarted",
        "title": "开始使用 zhouhe-dark",
        "description": "四步让配色与交互按 zhouhe-dark 的设计意图生效。",
        "steps": [
          {
            "id": "pickTheme",
            "title": "选中 zhouhe-dark 主题",
            "description": "在主题选择器里选中 **zhouhe-dark**。",
            "media": {
              "markdown": "./walkthroughs/01-pick-theme.md"
            },
            "completionEvents": [
              "onSettingChanged:workbench.colorTheme"
            ]
          },
          {
            "id": "disableModernUI",
            "title": "关闭 Modern UI（推荐）",
            "description": "经典布局下 zhouhe-dark 的配色才是完整的；一键定位到该设置并设为 `false`。",
            "media": {
              "markdown": "./walkthroughs/02-modern-ui.md"
            },
            "completionEvents": [
              "onSettingChanged:workbench.experimental.modernUI"
            ]
          },
          {
            "id": "semanticHighlighting",
            "title": "确认语义高亮已开启",
            "description": "语义高亮关闭时，主题里针对语义 token 的配色不会渲染。",
            "media": {
              "markdown": "./walkthroughs/03-semantic-highlighting.md"
            },
            "completionEvents": [
              "onSettingChanged:editor.semanticHighlighting.enabled"
            ]
          },
          {
            "id": "wordHighlight",
            "title": "启用单词高亮接管",
            "description": "让 zhouhe-dark 接管「高亮选中单词 / 出现处」的逻辑，配色跟随主题。",
            "media": {
              "markdown": "./walkthroughs/04-word-highlight.md"
            },
            "completionEvents": [
              "onCommand:zhouhe-dark.apply"
            ]
          }
        ]
      }
    ]
  }
}
